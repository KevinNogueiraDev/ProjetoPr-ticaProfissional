int login() {
    char senha[30];
    char usuario[50];
    
    int tentativas = 3;
    int valido = 0;
    
    do {
        printf("============= LOGIN =============\n");
        printf("Você tem: %d tentativas\n", tentativas);
        printf("Usuário: \n");
        fgets(usuario, 50, stdin);
        usuario[strcspn(usuario, "\n")] = '\0';
    
        printf("Senha: \n");
        fgets(senha, 30, stdin);
        senha[strcspn(senha, "\n")] = '\0';
    
        if (strcmp(usuario, "Miguel Thiago") == 0 && strcmp(senha, "1234") == 0) {
            valido = 1;
            return valido;
        } else {
            tentativas -= 1;
            system("clear");
        } 
    } while (tentativas > 0);
    return valido;
} 
 
